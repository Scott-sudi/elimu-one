# ELIMU One — production o2switch (copier vers .env sur le serveur)
# Ne jamais committer le fichier .env réel.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=GENERER-UNE-CLE-LONGUE-UNIQUE
DJANGO_DEBUG=False

# Remplacer par votre domaine + URL temporaire o2switch (*.odns.fr)
DJANGO_ALLOWED_HOSTS=votre-domaine.tld,www.votre-domaine.tld,votre-domaine.tld.susc3383.odns.fr
CSRF_TRUSTED_ORIGINS=https://votre-domaine.tld,https://www.votre-domaine.tld,https://votre-domaine.tld.susc3383.odns.fr,http://votre-domaine.tld.susc3383.odns.fr
DJANGO_SECURE_SSL_REDIRECT=True

# Nouvelle base MySQL ELIMU (cPanel → MySQL Databases)
DB_ENGINE=django.db.backends.mysql
DB_NAME=CPANELUSER_elimu
DB_USER=CPANELUSER_elimu_user
DB_PASSWORD=MOT_DE_PASSE_MYSQL
DB_HOST=localhost
DB_PORT=3306

PLATFORM_NAME=ELIMU One
PLATFORM_TAGLINE=Système de gestion scolaire
SCHOOL_NAME=
SCHOOL_SLOGAN=

# Chemins absolus sur o2switch (adapter CPANELUSER et dossier)
STATIC_ROOT=/home/CPANELUSER/elimu-school/backend/staticfiles
MEDIA_ROOT=/home/CPANELUSER/elimu-school/backend/media
DJANGO_LOG_DIR=/home/CPANELUSER/elimu-school/backend/logs
DJANGO_LOG_LEVEL=INFO

CORS_ALLOWED_ORIGINS=https://votre-domaine.tld,https://www.votre-domaine.tld
CACHE_LOCATION=elimu-one
CACHE_DEFAULT_TIMEOUT=300

EMAIL_HOST=mail.votre-domaine.tld
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@votre-domaine.tld
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@votre-domaine.tld
SERVER_EMAIL=noreply@votre-domaine.tld

APP_VERSION=1.0.0
TIME_ZONE=Africa/Lubumbashi
LANGUAGE_CODE=fr-fr

# Notifications push (optionnel — projet Firebase ELIMU)
FCM_PROJECT_ID=elimu-go
