DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_LOG_LEVEL=INFO
# DJANGO_LOG_DIR=/home/ACCOUNT/kalunga-school/backend/logs

# Local: SQLite (aucun serveur MySQL requis)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Production / hebergement: decommentez MySQL et commentez SQLite ci-dessus
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=elimu_school
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@cs-elimu.local
SERVER_EMAIL=noreply@cs-elimu.local

# --- Production (exemple a adapter sur l hebergeur) ---
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=votre-domaine.tld,www.votre-domaine.tld
# CSRF_TRUSTED_ORIGINS=https://votre-domaine.tld,https://www.votre-domaine.tld
# DJANGO_SECURE_SSL_REDIRECT=True
# CORS_ALLOWED_ORIGINS=https://votre-domaine.tld,https://www.votre-domaine.tld
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=elimu_school
# DB_USER=elimu_user
# DB_PASSWORD=replace-with-the-mysql-password
# DB_HOST=localhost
# DB_PORT=3306

# STATIC_ROOT=/home/ACCOUNT/kalunga-school/backend/staticfiles
# MEDIA_ROOT=/home/ACCOUNT/kalunga-school/backend/media
CACHE_LOCATION=elimu-school
CACHE_DEFAULT_TIMEOUT=300
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=12582912

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

TIME_ZONE=Africa/Lubumbashi
LANGUAGE_CODE=fr-fr

SCHOOL_NAME=
SCHOOL_SLOGAN=
PLATFORM_NAME=ELIMU One
PLATFORM_TAGLINE=Système de gestion scolaire
SCHOOL_CODE=
SCHOOL_REGIME=Privé agréé
SCHOOL_VACATION=Avant et Après-midi
SCHOOL_ADDRESS=
SCHOOL_CITY=
SCHOOL_BP=
SCHOOL_PHONE=
APP_VERSION=1.0.0

# Notifications push ELIMU Go (Firebase)
FCM_PROJECT_ID=elimu-go
FCM_SERVICE_ACCOUNT_FILE=secrets/firebase-adminsdk.json
